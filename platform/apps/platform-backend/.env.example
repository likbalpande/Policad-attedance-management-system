APP_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/policad-attendance-management-system

# PEM keys, single .env line with literal \n escapes for newlines.
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
ORIGIN_SIGN_PRIVATE_KEY=
ORIGIN_SIGN_PUBLIC_KEY=

OTP_TTL_SECONDS=300
STAFF_ACCESS_TOKEN_TTL_SECONDS=900
STAFF_REFRESH_TOKEN_TTL_SECONDS=604800
STUDENT_ACCESS_TOKEN_TTL_SECONDS=86400
STUDENT_REFRESH_TOKEN_TTL_SECONDS=2678400

# Optional - unset means traces print to stdout via a console exporter.
OTEL_SERVICE_NAME=policad-platform-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_DEPLOYMENT_ENVIRONMENT=
OTEL_SERVICE_NAMESPACE=
