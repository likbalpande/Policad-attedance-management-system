{
  "extends": "@platform/tsconfig/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "outDir": "dist",
    "noEmit": true,
    "moduleDetection": "force",
    "baseUrl": ".",
    "paths": {
      "@platform/*": ["../../packages/*/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "capacitor.config.ts"]
}
